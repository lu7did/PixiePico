


; * =======================================================================================
; * BFO
; * (c) Dr. Pedro E. Colla (LU7DZ) <pedro.colla@gmail.com>
; * 
; * Toggle output pin at each instraction (1 cycle per instruction) without any involvement
; * from core0 or core1
; * =======================================================================================*/
.program BFO
.wrap_target
    set pins, 1
    set pins, 0
.wrap
